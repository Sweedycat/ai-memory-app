{
  "expo": {
    "name": "AI Memory",
    "slug": "ai-memory-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AI Memory to use Face ID to protect your private memories."
        }
      ]
    ],
    "android": {
      "package": "com.sweedycat.aimemory"
    },
    "ios": {
      "bundleIdentifier": "com.sweedycat.aimemory"
    }
  }
}
