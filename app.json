{
  "expo": {
    "name": "AI Memory",
    "slug": "ai-memory-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AI Memory to use Face ID to protect your private memories."
        }
      ]
    ],
    "android": {
      "package": "com.sweedycat.aimemory",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.sweedycat.aimemory"
    },
    "extra": {
      "eas": {
        "projectId": "16c767fa-215f-497e-a7eb-55ff9435b428"
      }
    }
  }
}
